{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://football-research.local/schema/site.schema.json",
  "$defs": {
    "players": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "https://football-research.local/schema/players.schema.json#/$defs/player" },
          {
            "required": ["names"],
            "properties": {
              "names": {
                "type": "object",
                "required": ["zh", "en", "native", "ja", "ko"],
                "additionalProperties": { "type": "string" }
              }
            }
          }
        ]
      }
    },
    "overview": {
      "type": "object",
      "required": [
        "generated_at",
        "stats",
        "tournaments",
        "projects",
        "overseas_history",
        "dossiers",
        "scouting_watchlist",
        "tournament_archive",
        "china_men_youth_coaches",
        "china_youth_development_coaches",
        "football_stories",
        "big_five_asian_coaches",
        "asian_coaches",
        "youth_development_systems"
      ],
      "properties": {
        "generated_at": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
        "stats": {
          "type": "object",
          "required": ["player_count", "country_count", "foreign_registration_count"],
          "properties": {
            "player_count": { "type": "integer", "minimum": 0 },
            "country_count": { "type": "integer", "minimum": 0 },
            "foreign_registration_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "bigFiveDebutForecast": {
      "type": "object",
      "required": [
        "schema_version",
        "market",
        "last_checked",
        "previous_snapshot",
        "freshness",
        "model",
        "leader",
        "no_qualifier",
        "outcomes",
        "disclaimer"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "last_checked": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
        "previous_snapshot": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" }
          ]
        },
        "leader": {
          "type": "object",
          "required": ["player_id", "label", "probability", "probability_percent", "decimal_odds"]
        },
        "no_qualifier": {
          "type": "object",
          "required": ["probability", "probability_percent", "decimal_odds"]
        },
        "outcomes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "market_rank",
              "candidate_rank",
              "model_score",
              "probability",
              "probability_percent",
              "decimal_odds",
              "probability_change_pp",
              "label",
              "rationale",
              "factor_scores",
              "source_links"
            ],
            "properties": {
              "kind": { "enum": ["player", "other", "no-qualifier"] },
              "probability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "probability_percent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "decimal_odds": { "type": "number", "minimum": 1 },
              "probability_change_pp": { "type": ["number", "null"] },
              "factor_scores": { "type": "array" },
              "source_links": { "type": "array" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
