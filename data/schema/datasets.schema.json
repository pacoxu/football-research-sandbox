{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://football-research.local/schema/datasets.schema.json",
  "$defs": {
    "tournamentBroadcastPlan": {
      "type": "object",
      "required": ["status", "checked_at", "published_at", "announcement_title", "match", "platforms", "note", "source"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unavailable"] },
        "checked_at": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
        "published_at": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
        "announcement_title": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
        "match": {
          "type": "object",
          "required": ["date", "kickoff", "timezone", "home_team", "away_team", "stage", "venue"],
          "properties": {
            "date": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
            "kickoff": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
            "timezone": { "type": "string", "minLength": 1 },
            "home_team": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
            "away_team": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
            "stage": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
            "venue": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" }
          },
          "additionalProperties": false
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "channels"],
            "properties": {
              "name": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
              "channels": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" }
              }
            },
            "additionalProperties": false
          }
        },
        "note": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
        "source": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/sourceLink" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "complete" } } },
          "then": { "properties": { "platforms": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "tournamentTicketing": {
      "type": "object",
      "required": ["status", "checked_at", "currency", "price_tiers", "packages", "sales_channels", "loyalty_offer", "note", "source"],
      "properties": {
        "status": { "enum": ["announced", "on-sale", "closed", "unavailable"] },
        "checked_at": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "price_tiers": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["people", "discount_percent"],
            "properties": {
              "people": { "type": "integer", "minimum": 2 },
              "discount_percent": { "type": "integer", "minimum": 1, "maximum": 99 }
            },
            "additionalProperties": false
          }
        },
        "sales_channels": {
          "type": "array",
          "items": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" }
        },
        "loyalty_offer": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
        "note": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
        "source": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/sourceLink" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "on-sale" } } },
          "then": {
            "properties": {
              "price_tiers": { "minItems": 1 },
              "sales_channels": { "minItems": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "tournaments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "date_range", "last_checked", "sources"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "last_checked": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
          "broadcast_plan": { "$ref": "#/$defs/tournamentBroadcastPlan" },
          "ticketing": { "$ref": "#/$defs/tournamentTicketing" },
          "sources": { "type": "array", "items": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/sourceLink" } }
        },
        "additionalProperties": true
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "priority", "summary", "goal", "watch_items"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "goal": { "type": "string" },
          "watch_items": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "dossiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "summary", "last_reviewed", "roster_views"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "last_reviewed": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
          "roster_views": { "type": "array" }
        },
        "additionalProperties": true
      }
    },
    "footballStories": {
      "type": "object",
      "required": ["schema_version", "last_checked", "editorial_policy", "stories"],
      "properties": {
        "schema_version": { "const": 1 },
        "last_checked": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
        "editorial_policy": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
        "stories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "title", "summary", "checked_at", "related_entities", "identity_note", "key_facts", "timeline", "sections", "public_disputes", "source_links"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["person", "institution", "issue"] },
              "title": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
              "summary": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
              "identity_note": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
              "checked_at": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
              "related_entities": { "type": "array" },
              "key_facts": { "type": "array", "minItems": 1 },
              "timeline": { "type": "array", "minItems": 1 },
              "sections": { "type": "array", "minItems": 1 },
              "public_disputes": { "type": "array" },
              "source_links": { "type": "array", "minItems": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "scoutingWatchlist": {
      "type": "object",
      "required": ["schema_version", "source", "scope", "records", "related_collections"],
      "properties": {
        "schema_version": { "const": 1 },
        "source": {
          "type": "object",
          "required": ["name", "url", "source_tier", "checked_at", "caveat"],
          "properties": {
            "name": { "const": "Football Talent Scout" },
            "url": { "type": "string", "format": "uri" },
            "source_tier": { "const": "S2" },
            "checked_at": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
            "caveat": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" }
          },
          "additionalProperties": true
        },
        "scope": {
          "type": "object",
          "required": ["record_count", "country_count"],
          "properties": {
            "record_count": { "type": "integer", "minimum": 0 },
            "country_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "country", "birth_year", "report_type", "source_scope", "summary", "source_url", "source_checked_at"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "country": { "type": "string", "minLength": 1 },
              "birth_year": { "type": "integer", "minimum": 2000, "maximum": 2010 },
              "report_type": { "enum": ["image-report", "talent-of-the-day", "player-profile", "guest-report"] },
              "source_scope": { "enum": ["individual", "country-index", "category-index"] },
              "summary": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/localizedText" },
              "source_url": { "type": "string", "format": "uri" },
              "source_checked_at": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" }
            },
            "additionalProperties": true
          }
        },
        "related_collections": { "type": "array" }
      },
      "additionalProperties": true
    },
    "tournamentArchive": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "competition_name", "edition_label", "level", "status", "date_range", "champion", "runner_up"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "competition_name": { "type": "string", "minLength": 1 },
          "edition_label": { "type": "string", "minLength": 1 },
          "level": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "champion": { "type": ["string", "null"] },
          "runner_up": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "overseasHistory": {
      "type": "object",
      "required": ["bucket_definition", "countries"],
      "properties": {
        "bucket_definition": { "type": "array" },
        "countries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["country", "status", "verified_records", "featured_records"],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "uefaYouthLeague": {
      "type": "object",
      "required": ["meta", "seasons", "historical_season_index", "sources"],
      "properties": {
        "meta": { "type": "object" },
        "seasons": { "type": "array" },
        "historical_season_index": { "type": "array" },
        "sources": { "type": "array" }
      },
      "additionalProperties": true
    },
    "chinaNationalYouthCoaches": {
      "type": "object",
      "required": ["id", "last_checked", "team_cycles"],
      "properties": {
        "id": { "type": "string" },
        "last_checked": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
        "team_cycles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["team_label", "age_line", "head_coach", "source_links"],
            "properties": {
              "head_coach": {
                "type": "object",
                "required": ["id", "name", "local_name"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "local_name": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              },
              "source_links": { "type": "array", "items": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/sourceLink" } }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "coachCollection": {
      "type": "object",
      "required": ["id", "last_checked", "coaches"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "last_checked": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
        "coaches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "youthDevelopmentSystems": {
      "type": "object",
      "required": ["schema_version", "checked_at", "systems"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "checked_at": { "$ref": "https://football-research.local/schema/common.schema.json#/$defs/date" },
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "country", "name", "summary", "registration_categories", "competitions", "source_links"],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "marketValues": {
      "type": "object",
      "required": ["meta", "players"],
      "properties": {
        "meta": { "type": ["object", "null"] },
        "players": { "type": "object" }
      },
      "additionalProperties": true
    },
    "objectMap": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
